class Particella:
    def __init__(self, nome, massa, carica, spin):
        self.nome = nome
        self.massa = massa
        self.carica = carica
        self.spin = spin

    def energia_riposo(self):
        return self.massa * (3*10**8)**2

    def info(self):
        print(self.nome, self.massa, self.carica, self.spin)

    def e_stabile(self):
        if self.nome == "elettrone" or self.nome == "protone" or self.nome == "neutrone" or self.nome == "fotone":
            return True
        else:
            return False

class Carica(Particella):
    def __init__(self, nome, massa, carica, spin):
        super().__init__(nome, massa, carica, spin)

    def forza_coulomb(self, altra_particella, R):
        k = 9*10**9
        return k * ((self.carica * altra_particella.carica) / R**2)

